APP_NAME="City Imam Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.cityimam.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

ADMIN_TWO_FACTOR_ENABLED=true
ADMIN_TWO_FACTOR_ISSUER="City Imam Portal"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
